<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Workout_Activity">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:paddingStart="90dp"
        android:background="@color/light_red"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Workout List"
        android:textSize="24sp"
        android:textColor="@color/primary_red"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        tools:ignore="HardcodedText,RtlSymmetry" />
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/imgLegPress"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:contentDescription="Workout"
                android:scaleType="centerCrop"
                android:src="@drawable/biceps_workout"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/txtLegPressName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Leg Press"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/txtLegPressInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="4 sets of 12"
                android:textColor="@color/gray"
                android:textSize="16sp"
                tools:ignore="HardcodedText" />

            <LinearLayout
                style="?android:attr/buttonBarStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnLegPressBook"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary_red"
                    android:text="BOOK SLOT"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />

                <Button
                    android:id="@+id/btnLegPressTutorial"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="WATCH TUTORIAL"
                    android:textColor="@color/primary_red"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:contentDescription="Workout"
                android:id="@+id/imgLatPulldown"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/back_workout"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/txtLatPulldownName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lat Pulldown"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/txtLatPulldownInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 sets of 10"
                android:textSize="16sp"
                android:textColor="@color/gray"
                android:layout_marginBottom="8dp"
                tools:ignore="HardcodedText" />

            <LinearLayout
                style="?android:attr/buttonBarStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnLatPulldownBook"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="BOOK SLOT"
                    android:backgroundTint="@color/primary_red"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />

                <Button
                    android:id="@+id/btnLatPulldownTutorial"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="WATCH TUTORIAL"
                    android:textColor="@color/primary_red"
                    android:textSize="14sp"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:contentDescription="Workout"
                android:id="@+id/imgChestPress"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/biceps_workout"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/txtChestPressName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chest Press"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/txtChestPressInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 sets of 12"
                android:textSize="16sp"
                android:textColor="@color/gray"
                android:layout_marginBottom="8dp"
                tools:ignore="HardcodedText" />

            <LinearLayout
                style="?android:attr/buttonBarStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnChestPressBook"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="BOOK SLOT"
                    android:backgroundTint="@color/primary_red"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />

                <Button
                    android:id="@+id/btnChestPressTutorial"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="WATCH TUTORIAL"
                    android:background="@color/primary_red"
                    android:textSize="14sp"
                    tools:ignore="ButtonStyle,HardcodedText" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


</LinearLayout>
</ScrollView>